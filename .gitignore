# Large files (use Git LFS for files larger than 50MB)
*.{mp4,mov,avi,data,json,mat,weights,pt,pb,onnx,engine,mlmodel,torchscript,tflite,h5} diff=lfs merge=lfs -text

# Ignore all files larger than 50MB (use Git LFS for large files)
* diff=lfs merge=lfs -text

# Allow .ipynb files (Jupyter Notebook) of any size
!*.ipynb


