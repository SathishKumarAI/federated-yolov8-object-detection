# Runtime-generated data configs (materialize_data_yaml)
**/data.runtime.yaml

# Federated global-model checkpoints
checkpoints/

# Pretrained weights Ultralytics downloads on its own. The AMP check pulls a small
# model into the CWD the first time train() runs, so one lands in the repo root
# after any baseline or sanity run. They are 5-50 MB each and reproducible.
/*.pt
/models/
my-project/models/*.pt

# TLS certificates (secrets)
certs/

# --- pipeline component -------------------------------------------------
# Generated data and run artifacts. None of this belongs in the repo: the fleet
# shards are hardlinks to a 7.6 GB dataset, the MLflow store holds model
# artifacts, and reports are per-run output.
pipeline/vehicles/
pipeline/mlruns/
# Ultralytics' MLflow callback runs with cwd=my-project. Until it is pointed at the
# pipeline's experiment it drops artifacts here, and a stray store is still a store.
my-project/mlruns/
pipeline/reports/
pipeline/.state/
pipeline/**/__pycache__/

# Credentials, belt and braces. The pipeline reads none of these -- kagglehub
# downloads anonymously -- but a stray copy must never become committable.
kaggle.json
**/kaggle.json
.env
*.pem
*.key
!my-project/certs/.gitkeep

# my-project's loggers use CWD-relative paths, so running pytest from the repo
# root (rather than from my-project/) drops stray per-process log files here.
# Narrow on purpose: logs/installation.log is tracked and must stay.
/logs/*.*.log
/logs/server.log
/logs/client.log
/logs/task.log
/logs/get_set.log
/logs/metrics.log

# Claude Code agent worktrees: a nested git worktree of this repo, created by a
# background agent. Generated, machine-local, and a checkout of the repo inside
# itself -- never committed.
.claude/worktrees/
